+    @Test
+    public void testDecode()
+    {
+        assertThat(expression("decode(a, 1, 'x')"))
+                .isEqualTo(new SimpleCaseExpression(
+                        location(1, 1),
+                        new Identifier(location(1, 8), "a", false),
+                        ImmutableList.of(
+                                new WhenClause(
+                                        location(1, 11),
+                                        new DistinctFromPredicate(location(1, 11), true, new LongLiteral(location(1, 11), "1")),
+                                        new StringLiteral(location(1, 14), "x"))),
+                        Optional.empty()));
+        Expression decodeWithDefault = new SimpleCaseExpression(
+                location(1, 1),
+                new Identifier(location(1, 8), "a", false),
+                ImmutableList.of(
+                        new WhenClause(
+                                location(1, 11),
+                                new DistinctFromPredicate(location(1, 11), true, new LongLiteral(location(1, 11), "1")),
+                                new StringLiteral(location(1, 14), "x"))),
+                Optional.of(new StringLiteral(location(1, 19), "y")));
+        assertThat(expression("decode(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("DECODE(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("Decode(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("decode(a, 1, 'x', null, 'n')"))
+                .isEqualTo(new SimpleCaseExpression(
+                        location(1, 1),
+                        new Identifier(location(1, 8), "a", false),
+                        ImmutableList.of(
+                                new WhenClause(
+                                        location(1, 11),
+                                        new DistinctFromPredicate(location(1, 11), true, new LongLiteral(location(1, 11), "1")),
+                                        new StringLiteral(location(1, 14), "x")),
+                                new WhenClause(
+                                        location(1, 19),
+                                        new DistinctFromPredicate(location(1, 19), true, new NullLiteral(location(1, 19))),
+                                        new StringLiteral(location(1, 25), "n"))),
+                        Optional.empty()));
+        assertThat(expression("x.decode(a, 1, 'x')")).isInstanceOf(FunctionCall.class);
+
+        assertInvalidExpression("decode()", "The 'decode' function must have at least three arguments");
+        assertInvalidExpression("decode(a)", "The 'decode' function must have at least three arguments");
+        assertInvalidExpression("decode(a, 1)", "The 'decode' function must have at least three arguments");
+        assertInvalidExpression("decode(a, 1, 'x') OVER ()", "OVER clause not valid for 'decode' function");
+        assertInvalidExpression("decode(a, 1, 'x') filter (where true)", "FILTER not valid for 'decode' function");
+        assertInvalidExpression("decode(DISTINCT a, 1, 'x')", "DISTINCT not valid for 'decode' function");
+        assertInvalidExpression("RUNNING decode(a, 1, 'x')", "Running or final semantics not valid for 'decode' function");
+        assertInvalidExpression("decode(a => 1, 1, 'x')", "Named arguments are not supported for 'decode' function");
+    }
