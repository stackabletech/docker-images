+package io.trino.sql.query;
+
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestInstance;
+import org.junit.jupiter.api.parallel.Execution;
+
+import java.util.function.IntFunction;
+
+import static io.trino.spi.StandardErrorCode.TYPE_MISMATCH;
+import static java.util.stream.Collectors.joining;
+import static java.util.stream.IntStream.rangeClosed;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.api.TestInstance.Lifecycle.PER_CLASS;
+import static org.junit.jupiter.api.parallel.ExecutionMode.CONCURRENT;
+
+@TestInstance(PER_CLASS)
+@Execution(CONCURRENT)
+public class TestDecode
+{
+    private final QueryAssertions assertions = new QueryAssertions();
+
+    @AfterAll
+    public void teardown()
+    {
+        assertions.close();
+    }
+
+    @Test
+    public void testBasic()
+    {
+        assertThat(assertions.query("SELECT decode(1, 1, 'one', 2, 'two')")).matches("VALUES 'one'");
+        assertThat(assertions.query("SELECT decode(2, 1, 'one', 2, 'two')")).matches("VALUES 'two'");
+        assertThat(assertions.query("SELECT decode(3, 1, 'one', 2, 'two', 'other')")).matches("VALUES 'other'");
+        assertThat(assertions.query("SELECT DECODE(2, 1, 'one', 2, 'two', 'other')")).matches("VALUES CAST('two' AS varchar(5))");
+
+        assertThat(assertions.query(
+                """
+                SELECT x, decode(x, 1, 'one', 2, 'two', 'other')
+                FROM (VALUES 1, 2, 3, NULL) t(x)
+                """))
+                .matches("VALUES (1, CAST('one' AS varchar(5))), (2, 'two'), (3, 'other'), (NULL, 'other')");
+    }
+
+    @Test
+    public void testNoMatchWithoutDefault()
+    {
+        assertThat(assertions.query("SELECT decode(3, 1, 'one', 2, 'two')")).matches("VALUES CAST(NULL AS varchar(3))");
+    }
+
+    @Test
+    public void testNullMatchesNull()
+    {
+        assertThat(assertions.query("SELECT decode(NULL, NULL, 'n', 'other')")).matches("VALUES CAST('n' AS varchar(5))");
+        assertThat(assertions.query("SELECT decode(1, NULL, 'n', 'other')")).matches("VALUES 'other'");
+        assertThat(assertions.query("SELECT decode(NULL, 1, 'one', 'other')")).matches("VALUES 'other'");
+        assertThat(assertions.query(
+                """
+                SELECT x, decode(x, 1, 'one', NULL, 'null', 'other')
+                FROM (VALUES 1, 2, NULL) t(x)
+                """))
+                .matches("VALUES (1, CAST('one' AS varchar(5))), (2, 'other'), (NULL, 'null')");
+        assertThat(assertions.query(
+                """
+                SELECT decode(x, s, 'match', 'other')
+                FROM (VALUES (1, 1), (1, 2), (1, NULL), (NULL, 1), (NULL, NULL)) t(x, s)
+                """))
+                .matches("VALUES 'match', 'other', 'other', 'other', 'match'");
+    }
+
+    @Test
+    public void testFirstMatchWins()
+    {
+        assertThat(assertions.query("SELECT decode(1, 1, 'first', 1, 'second', 'other')")).matches("VALUES CAST('first' AS varchar(6))");
+        assertThat(assertions.query("SELECT decode(NULL, NULL, 'first', NULL, 'second')")).matches("VALUES CAST('first' AS varchar(6))");
+    }
+
+    @Test
+    public void testShortCircuit()
+    {
+        assertThat(assertions.query(
+                """
+                SELECT decode(x, 1, 'ok', 2, CAST(1 / (x - 1) AS varchar))
+                FROM (VALUES 1) t(x)
+                """))
+                .matches("VALUES VARCHAR 'ok'");
+        assertThat(assertions.query(
+                """
+                SELECT decode(x, 1, 'ok', CAST(1 / (x - 1) AS varchar))
+                FROM (VALUES 1) t(x)
+                """))
+                .matches("VALUES VARCHAR 'ok'");
+    }
+
+    @Test
+    public void testExpressionsAsArguments()
+    {
+        assertThat(assertions.query(
+                """
+                SELECT decode(x + 1, y * 2, 'a', y * 3, 'b', concat('c', CAST(x AS varchar)))
+                FROM (VALUES (3, 2), (5, 2), (7, 3)) t(x, y)
+                """))
+                .matches("VALUES VARCHAR 'a', 'b', 'c7'");
+    }
+
+    @Test
+    public void testResultTypeCoercion()
+    {
+        assertThat(assertions.query("SELECT decode(1, 1, 1, 2, 2.5, 3e0)")).matches("VALUES 1e0");
+        assertThat(assertions.query("SELECT decode(BIGINT '1', 1, 'one')")).matches("VALUES 'one'");
+    }
+
+    @Test
+    public void testTypeMismatch()
+    {
+        assertThat(assertions.query("SELECT decode('a', 1, 'x')"))
+                .failure()
+                .hasErrorCode(TYPE_MISMATCH)
+                .hasMessageContaining("line 1:20: Cannot check if varchar(1) is identical to integer");
+        assertThat(assertions.query("SELECT decode(1, 1, 'x', 2, 3)"))
+                .failure()
+                .hasErrorCode(TYPE_MISMATCH);
+    }
+
+    @Test
+    public void testManyArguments()
+    {
+        // 127 is the maximum number of arguments for a function call, DECODE is rewritten before that check.
+        // The input comes from UNNEST rather than VALUES, so that the planner cannot fold the expressions into
+        // constants and the generated bytecode, which is subject to the JVM method size limit, gets exercised.
+        String input = "UNNEST(sequence(BIGINT '0', BIGINT '1000') || ARRAY[CAST(NULL AS bigint)]) t(x)";
+        for (int argumentCount : new int[] {127, 128, 253, 254, 499, 500}) {
+            int pairs = (argumentCount - 1) / 2;
+            boolean hasDefault = argumentCount % 2 == 0;
+
+            String bigintDecode = "decode(x" + pairs(pairs, i -> i + ", 'r" + i + "'") + (hasDefault ? ", 'default'" : "") + ")";
+            String bigintExpected = "IF(x BETWEEN 1 AND " + pairs + ", 'r' || CAST(x AS varchar), " + (hasDefault ? "'default'" : "NULL") + ")";
+            assertThat(assertions.query(
+                    "SELECT count(*), count_if(" + bigintDecode + " IS DISTINCT FROM " + bigintExpected + ") FROM " + input))
+                    .matches("VALUES (BIGINT '1002', BIGINT '0')");
+            assertThat(assertions.query(
+                    "SELECT x FROM " + input + " WHERE " + bigintDecode + " = 'r" + pairs + "'"))
+                    .matches("VALUES BIGINT '" + pairs + "'");
+
+            String varcharDecode = "decode(CAST(x AS varchar)" + pairs(pairs, i -> "'" + i + "', " + i) + (hasDefault ? ", -1" : "") + ")";
+            String varcharExpected = "IF(x BETWEEN 1 AND " + pairs + ", x, " + (hasDefault ? "-1" : "NULL") + ")";
+            assertThat(assertions.query(
+                    "SELECT count(*), count_if(" + varcharDecode + " IS DISTINCT FROM " + varcharExpected + ") FROM " + input))
+                    .matches("VALUES (BIGINT '1002', BIGINT '0')");
+        }
+    }
+
+    private static String pairs(int count, IntFunction<String> pair)
+    {
+        return rangeClosed(1, count)
+                .mapToObj(pair)
+                .collect(joining(", ", ", ", ""));
+    }
+}
