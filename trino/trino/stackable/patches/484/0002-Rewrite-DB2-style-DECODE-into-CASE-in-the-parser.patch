+        if (name.toString().equalsIgnoreCase("decode")) {
+            check(arguments.size() >= 3, "The 'decode' function must have at least three arguments", context);
+            check(window.isEmpty(), "OVER clause not valid for 'decode' function", context);
+            check(!distinct, "DISTINCT not valid for 'decode' function", context);
+            check(nullTreatment == null, "Null treatment clause not valid for 'decode' function", context);
+            check(processingMode == null, "Running or final semantics not valid for 'decode' function", context);
+            check(filter.isEmpty(), "FILTER not valid for 'decode' function", context);
+            check(!hasNamedArguments, "Named arguments are not supported for 'decode' function", context);
+
+            // DB2-style DECODE(e, s1, r1, ..., [default]) where a NULL e matches a NULL si:
+            // CASE e WHEN IS NOT DISTINCT FROM s1 THEN r1 ... ELSE default END
+            ImmutableList.Builder<WhenClause> whenClauses = ImmutableList.builder();
+            for (int i = 1; i + 1 < arguments.size(); i += 2) {
+                NodeLocation searchLocation = getLocation(context.argument(i));
+                whenClauses.add(new WhenClause(
+                        searchLocation,
+                        new DistinctFromPredicate(searchLocation, true, arguments.get(i).getValue()),
+                        arguments.get(i + 1).getValue()));
+            }
+            Optional<Expression> defaultValue = Optional.empty();
+            if (arguments.size() % 2 == 0) {
+                defaultValue = Optional.of(arguments.getLast().getValue());
+            }
+
+            return new SimpleCaseExpression(getLocation(context), arguments.getFirst().getValue(), whenClauses.build(), defaultValue);
+        }
+
         if (name.toString().equalsIgnoreCase("try")) {
             check(arguments.size() == 1, "The 'try' function must have exactly one argument", context);
             check(window.isEmpty(), "OVER clause not valid for 'try' function", context);
