+CREATE TABLE timestamp_tz_millis (id INTEGER, ts TIMESTAMP WITH TIME ZONE)
+WITH (location = ?);
+
+INSERT INTO timestamp_tz_millis VALUES
+(1, TIMESTAMP '2024-01-15 10:30:00.123 UTC'),
+(2, TIMESTAMP '2024-06-20 16:45:30.456 UTC'),
+(3, NULL);
+```
