+        if (name.toString().equalsIgnoreCase("decode")) {
+            check(context.expression().size() >= 3, "The 'decode' function must have at least three arguments", context);
+            check(window.isEmpty(), "OVER clause not valid for 'decode' function", context);
+            check(!distinct, "DISTINCT not valid for 'decode' function", context);
+            check(nullTreatment == null, "Null treatment clause not valid for 'decode' function", context);
+            check(processingMode == null, "Running or final semantics not valid for 'decode' function", context);
+            check(filter.isEmpty(), "FILTER not valid for 'decode' function", context);
+
+            // DB2-style DECODE(e, s1, r1, ..., [default]) where a NULL e matches a NULL si:
+            // CASE WHEN NOT (e IS DISTINCT FROM s1) THEN r1 ... ELSE default END
+            List<SqlBaseParser.ExpressionContext> expressions = context.expression();
+            SqlBaseParser.ExpressionContext operand = expressions.getFirst();
+            ImmutableList.Builder<WhenClause> whenClauses = ImmutableList.builder();
+            for (int i = 1; i + 1 < expressions.size(); i += 2) {
+                SqlBaseParser.ExpressionContext search = expressions.get(i);
+                // visit the operand per branch so that each branch gets its own tree nodes
+                Expression condition = new NotExpression(
+                        getLocation(search),
+                        new ComparisonExpression(
+                                getLocation(search),
+                                ComparisonExpression.Operator.IS_DISTINCT_FROM,
+                                (Expression) visit(operand),
+                                (Expression) visit(search)));
+                whenClauses.add(new WhenClause(getLocation(search), condition, (Expression) visit(expressions.get(i + 1))));
+            }
+            Optional<Expression> defaultValue = Optional.empty();
+            if (expressions.size() % 2 == 0) {
+                defaultValue = Optional.of((Expression) visit(expressions.getLast()));
+            }
+
+            return new SearchedCaseExpression(getLocation(context), whenClauses.build(), defaultValue);
+        }
+
         if (name.toString().equalsIgnoreCase("try")) {
             check(context.expression().size() == 1, "The 'try' function must have exactly one argument", context);
             check(window.isEmpty(), "OVER clause not valid for 'try' function", context);
