+    {
+        assertThat(expression("decode(a, 1, 'x')"))
+                .isEqualTo(new SearchedCaseExpression(
+                        location(1, 1),
+                        ImmutableList.of(
+                                new WhenClause(
+                                        location(1, 11),
+                                        new NotExpression(
+                                                location(1, 11),
+                                                new ComparisonExpression(
+                                                        location(1, 11),
+                                                        ComparisonExpression.Operator.IS_DISTINCT_FROM,
+                                                        new Identifier(location(1, 8), "a", false),
+                                                        new LongLiteral(location(1, 11), "1"))),
+                                        new StringLiteral(location(1, 14), "x"))),
+                        Optional.empty()));
+        Expression decodeWithDefault = new SearchedCaseExpression(
+                location(1, 1),
+                ImmutableList.of(
+                        new WhenClause(
+                                location(1, 11),
+                                new NotExpression(
+                                        location(1, 11),
+                                        new ComparisonExpression(
+                                                location(1, 11),
+                                                ComparisonExpression.Operator.IS_DISTINCT_FROM,
+                                                new Identifier(location(1, 8), "a", false),
+                                                new LongLiteral(location(1, 11), "1"))),
+                                new StringLiteral(location(1, 14), "x"))),
+                Optional.of(new StringLiteral(location(1, 19), "y")));
+        assertThat(expression("decode(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("DECODE(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("Decode(a, 1, 'x', 'y')")).isEqualTo(decodeWithDefault);
+        assertThat(expression("decode(a, 1, 'x', null, 'n')"))
+                .isEqualTo(new SearchedCaseExpression(
+                        location(1, 1),
+                        ImmutableList.of(
+                                new WhenClause(
+                                        location(1, 11),
+                                        new NotExpression(
+                                                location(1, 11),
+                                                new ComparisonExpression(
+                                                        location(1, 11),
+                                                        ComparisonExpression.Operator.IS_DISTINCT_FROM,
+                                                        new Identifier(location(1, 8), "a", false),
+                                                        new LongLiteral(location(1, 11), "1"))),
+                                        new StringLiteral(location(1, 14), "x")),
+                                new WhenClause(
+                                        location(1, 19),
+                                        new NotExpression(
+                                                location(1, 19),
+                                                new ComparisonExpression(
+                                                        location(1, 19),
+                                                        ComparisonExpression.Operator.IS_DISTINCT_FROM,
+                                                        new Identifier(location(1, 8), "a", false),
+                                                        new NullLiteral(location(1, 19)))),
+                                        new StringLiteral(location(1, 25), "n"))),
+                        Optional.empty()));
+        assertThat(expression("x.decode(a, 1, 'x')"))
+                .isEqualTo(new FunctionCall(
+                        location(1, 1),
