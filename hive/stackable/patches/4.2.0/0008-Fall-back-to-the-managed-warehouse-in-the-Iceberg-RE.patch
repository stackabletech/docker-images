   @Test
   public void testCreateTableTxnBuilder() throws Exception {
     Schema schema = getTestSchema();
@@ -1259,4 +1275,19 @@ public class TestHiveCatalog extends CatalogTests<HiveCatalog> {
 
     assertThat(database.getLocationUri()).isEqualTo("s3://bucket/database.db");
   }
+
+  @Test
+  public void testDatabaseLocationWithoutExternalWarehouseDir() {
+    Configuration conf = new Configuration();
+    conf.set("hive.metastore.warehouse.dir", "s3://bucket/warehouse");
+
+    HiveCatalog hiveCatalog = new HiveCatalog();
+    hiveCatalog.setConf(conf);
+
+    Database database = hiveCatalog.convertToDatabase(Namespace.of("database"), ImmutableMap.of());
+
+    // Falls back to the managed warehouse, like HMS itself does
+    assertThat(database.getLocationUri()).isEqualTo("s3://bucket/warehouse/database.db");
+    assertThat(database.getManagedLocationUri()).isEqualTo("s3://bucket/warehouse/database.db");
+  }
 }
